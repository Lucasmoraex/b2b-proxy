{
  "name": "b2b-proxy",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.1"
  },
  "scripts": {
    "start": "node server.js",
    "worker": "node src/worker-main.js",
    "migrate": "node scripts/migrate.js",
    "shopify:webhook:register": "node scripts/register-shopify-webhook.js",
    "simulation:webhook:fixture": "node scripts/generate-simulated-webhook.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage test/*.test.js",
    "check": "node --check server.js && node --check src/app.js && node --check src/worker.js && node --check scripts/register-shopify-webhook.js && node --check scripts/generate-simulated-webhook.js"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
