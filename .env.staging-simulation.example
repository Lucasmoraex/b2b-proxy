PORT=3000
B2B_ENVIRONMENT=staging
NODE_ENV=development
DATABASE_URL=postgres://staging_user:staging_password@staging-db.invalid:5432/staging_db
DATABASE_SSL=false
SHOPIFY_SHOP=simulation.example.invalid
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=sim_replace-with-random-staging-only-secret
B2B_ADMIN_SECRET=replace-with-random-staging-only-admin-secret
B2B_REGISTRATION_TOKEN_SECRET=replace-with-random-staging-only-registration-secret
B2B_ALLOWED_ORIGIN=https://theme-staging.example.invalid
B2B_RECEITAWS_BASE=https://registry.example.invalid/v1
B2B_RECEITAWS_TOKEN=
B2B_RECEITAWS_TOKEN_MODE=bearer
B2B_AUTO_APPROVE=false
B2B_ENABLE_LEGACY_MUTATIONS=false
B2B_ENABLE_LEGACY_LOGIN=false
B2B_REQUEST_TIMEOUT_MS=8000
B2B_RESERVATION_TTL_MS=1800000
B2B_RATE_LIMIT_WINDOW_MS=60000
B2B_RATE_LIMIT_MAX=30
B2B_WORKER_POLL_MS=2000
B2B_WORKER_MAX_ATTEMPTS=8
B2B_SIMULATION_MODE=true
B2B_SIMULATION_CONFIRMATION=ENABLE_ISOLATED_SIMULATION
B2B_SIMULATED_REGISTRY_SCENARIO=active
